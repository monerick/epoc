[Unit]
Description=Secure Data Grapher Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/secure-grapher
EnvironmentFile=/opt/secure-grapher/.env
ExecStart=/opt/secure-grapher/venv/bin/python /opt/secure-grapher/run.py
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
